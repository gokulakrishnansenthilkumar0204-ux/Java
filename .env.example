# Copy this file to ".env" (same folder as pom.xml) and fill in your Supabase values.
# The application reads .env automatically on startup - no extra commands needed.
# Do NOT put quotes around the values.
#
# Direct connection:      jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require
# Pooler (recommended):   jdbc:postgresql://aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
#                         (username is then postgres.<project-ref>)

SUPABASE_DB_URL=jdbc:postgresql://YOUR_HOST:6543/postgres?sslmode=require
SUPABASE_DB_USERNAME=YOUR_DATABASE_USERNAME
SUPABASE_DB_PASSWORD=YOUR_DATABASE_PASSWORD
